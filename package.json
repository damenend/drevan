{
  "name": "game",
  "version": "1.0.0",
  "main": "dist/app.js",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@openai/codex": "^0.170.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/app.ts\" \"sass --watch src/scss/main.scss:public/css/main.css\"",
    "build": "tsc && yarn sass:build",
    "start": "node dist/app.js",
    "sass:build": "sass src/scss/main.scss public/css/main.css --style=expanded",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src drizzle.config.ts scripts",
    "typecheck": "tsc --noEmit",
    "check": "yarn format:check && yarn lint && yarn typecheck",
    "hooks:install": "node scripts/install-hooks.mjs",
    "docs:agents": "codex exec --sandbox workspace-write \"Review AGENTS.md against the current tracked repository, including staged and unstaged changes, and any relevant new source or config files. Skip ignored files and local secrets. Update only AGENTS.md where gameplay rules, architecture, or contributor workflows have changed. Leave it untouched if it is current. Summarize findings without staging or committing anything.\""
  }
}
