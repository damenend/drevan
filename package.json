{
  "name": "game",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "sass": "^1.107.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "concurrently \"tsx watch src/app.ts\" \"sass --watch src/scss/main.scss:public/css/main.css\"",
    "build": "tsc",
    "start": "node dist/app.js",
    "sass:build": "sass src/scss/main.scss public/css/main.css --style=compressed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts"
  }
}
