```gitignore
# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment variables
.env
.env.*
!.env.example

# SQLite database
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/*.sqlite-journal

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# Yarn
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Editor and OS files
.DS_Store
Thumbs.db
.vscode-test/

# Temporary files
*.tmp
*.temp
.cache/
```