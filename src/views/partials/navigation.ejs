<nav class="main-navigation">
  <% if (user) { %>
  <a href="/game" <%- currentPath === '/game' ? 'aria-current="page"' : '' %>>Home</a>
  <a href="/game/arena" <%- currentPath === '/game/arena' || currentPath === '/game/training' ? 'aria-current="page"' : '' %>>Dominion</a>
  <a href="/game/store" <%- currentPath === '/game/store' ? 'aria-current="page"' : '' %>>Curious Emporium</a>
  <a href="/game/hospital" <%- currentPath === '/game/hospital' ? 'aria-current="page"' : '' %>>Sanctum</a>
  <a href="/users" <%- currentPath === '/users' ? 'aria-current="page"' : '' %>>Players</a>
  <a href="/game/admin" <%- currentPath === '/game/admin' ? 'aria-current="page"' : '' %>>Admin</a>

  <form action="/logout" method="POST">
    <button class="button-link" type="submit">Logout</button>
  </form>
  <% } else { %>
  <a href="/" <%- currentPath === '/' ? 'aria-current="page"' : '' %>>Home</a>
  <% } %>
</nav>