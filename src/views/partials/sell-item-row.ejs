<tr>
  <th scope="row">
    <%- include("./item-figure", { item }) %>
  </th>
  <td><%= formatNumber(item.available) %></td>
  <td><%= formatNumber(item.sellPrice) %></td>
  <td>
    <% if (item.available === 0) { %>
    <a href="/game#equipped">Unequip in The Quarters</a>
    <% } else { %>
    <%- include("./cart-quantity", {
      fieldId: `sell-${item.id}`, itemId: item.id,
      label: `Quantity of ${item.name} to sell`, price: item.sellPrice, maxQuantity: item.available,
    }) %>
    <% } %>
  </td>
</tr>
