<div class="battle-stats">
  <h<%= headingLevel %><% if (headingLevel === 3) { %> class="section-heading"<% } %><% if (locals.focusBattleSummary) { %> tabindex="-1" data-result-focus aria-describedby="battle-summary-values"<% } %>>Battle summary</h<%= headingLevel %>>
  <div id="battle-summary-values">
    <p><span class="battle-actor--player"><%= formatPlayerName(user.name) %></span> HP changed from <%= formatNumber(startingPlayerHp) %> to <%= formatNumber(playerHp) %></p>
    <p><span class="battle-actor--enemy"><%= enemyName %></span> HP changed from <%= formatNumber(startingEnemyHp) %> to <%= formatNumber(enemyHp) %></p>
    <% if (entry.result === "win") { %>
    <p>
      <span class="battle-actor--player"><%= entry.player %></span> wins.
    </p>
    <p>Reward: <%= formatNumber(entry.reward) %> gold, <%= formatNumber(xpEarned) %> XP<% if (typeof loot !== "undefined" && loot) { %>, Loot: <%= loot %><% } %></p>
    <% } else if (entry.result === "loss") { %>
    <p><span class="battle-actor--player"><%= entry.player %></span> was defeated.</p>
    <% } else if (entry.result === "draw") { %>
    <p>
      The battle ended in a draw.
      You keep your remaining HP and earn no reward.
    </p>
    <% } %>
  </div>
</div>
