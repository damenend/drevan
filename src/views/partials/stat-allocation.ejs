    <% if (progression.unspentPoints > 0) { %>
    <form class="cluster cluster--gap-small stat-allocation" action="/game/progression" method="POST" aria-label="Spend one attribute point">
      <% for (const [stat, option] of Object.entries(statAllocations)) { %>
      <button type="submit" name="stat" value="<%= stat %>" aria-label="<%= option.label %> (spend one attribute point)"><%= option.label %></button>
      <% } %>
    </form>
    <% } %>
