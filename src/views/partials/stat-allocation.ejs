    <% if (progression.unspentPoints > 0) { %>
    <form action="/game/progression" method="POST" aria-label="Spend one stat point">
      <% for (const [stat, option] of Object.entries(statAllocations)) { %>
      <button type="submit" name="stat" value="<%= stat %>"><%= option.label %></button>
      <% } %>
    </form>
    <% } %>
