<% const bonus = total - base; %>
<%= formatNumber(total) %>
<% if (bonus !== 0) { %>
  <span class="character-stat-breakdown">(<%= formatNumber(base) %> <span class="stat-change stat-change--<%= bonus > 0 ? "positive" : "negative" %>"><%= bonus > 0 ? "+" : "−" %> <%= formatNumber(Math.abs(bonus)) %></span>)</span>
<% } %>
