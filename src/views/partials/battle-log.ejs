  <% const headingLevel = typeof battleHeadingLevel === "undefined" ? 4 : battleHeadingLevel; %>
  <div class="battle-log">
    <% battleLog.forEach(entry => { %>
    <% if (entry.type === "encounter") { %>
    <p>
      <span class="player"><%= entry.player %></span> encounters <span class="enemy"><%= entry.target %></span>!
    </p>
    <h<%= headingLevel %>>Battle log</h<%= headingLevel %>>
    <% } else if (entry.type === "attack") { %>
    <p class="battle-log-entry battle-log-entry--<%= entry.actor %><%= entry.critical ? ' battle-log-entry--critical' : '' %>">
      <span class="<%= entry.actor %>"><%= entry.player %></span>
      attacks
      <span class="<%= entry.actor === 'player' ? 'enemy' : 'player' %>"><%= entry.target %></span>
      for
      <strong><%= formatNumber(entry.damage) %></strong>
      damage!
      <% if (entry.critical) { %>
      <strong class="critical-hit">Critical Hit!</strong>
      <% } %>
    </p>
    <% } else if (entry.type === "outcome") { %>
    <div class="battle-stats">
      <h<%= headingLevel %>>Battle summary</h<%= headingLevel %>>
      <p><span class="player"><%= formatPlayerName(user.name) %></span> HP: <%= formatNumber(startingPlayerHp) %> → <%= formatNumber(playerHp) %></p>
      <p><span class="enemy"><%= enemyName %></span> HP: <%= formatNumber(startingEnemyHp) %> → <%= formatNumber(enemyHp) %></p>
      <% if (entry.result === "win") { %>
      <p>
        <span class="player"><%= entry.player %></span> wins!
      </p>
      <p>Reward: <%= formatNumber(entry.reward) %> gold, <%= formatNumber(xpEarned) %> XP</p>
      <% } else if (entry.result === "loss") { %>
      <p><span class="player"><%= entry.player %></span> was defeated!</p>
      <% } else if (entry.result === "draw") { %>
      <p>
        The battle ended in a draw.
        You keep your remaining HP and earn no reward.
      </p>
      <% } %>
    </div>
    <% } %>
    <% }) %>
  </div>
