<div class="health-meter">
  <label for="<%= id %>">HP <span aria-hidden="true"><%= formatNumber(user.hp) %> / <%= formatNumber(user.maxHp) %></span></label>
  <meter id="<%= id %>" min="0" max="<%= user.maxHp %>" value="<%= user.hp %>" class="<%= user.hp / user.maxHp < 0.25 ? 'health-meter--low' : '' %>" aria-valuetext="<%= formatNumber(user.hp) %> of <%= formatNumber(user.maxHp) %> HP"></meter>
</div>
