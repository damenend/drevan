<figure class="item-group">
  <% if (item.image) { %>
    <img src="<%= item.image %>" alt="" width="48" height="48" class="item-icon<%= locals.compact ? ' item-icon--compact' : '' %>">
  <% } %>
  <figcaption><% if (locals.showDescription) { %>
    <strong><%= item.name %></strong>
    <% if (item.description) { %><span class="item-description"><%= item.description %></span><% } %>
  <% } else { %><%= item.name %><% } %><% if (locals.itemQuantity !== undefined) { %>
    <span class="item-group__quantity">Quantity: <%= formatNumber(itemQuantity) %></span>
  <% } %></figcaption>
</figure>
