<figure class="item-group">
  <% if (item.image) { %>
    <img src="<%= item.image %>" alt="" width="48" height="48" class="item-icon">
  <% } %>
  <figcaption><%= item.name %><% if (locals.itemQuantity !== undefined) { %>
    <span class="ruins-item-quantity">Quantity: <%= formatNumber(itemQuantity) %></span>
  <% } %></figcaption>
</figure>
