<tr>
  <th scope="row">
    <%- include("./item-figure", { item }) %>
  </th>
  <td><%= item.description %></td>
  <td><%= getItemEffectLabel(item.effect) %></td>
  <td><%= item.effectValue === null ? "—" : formatNumber(item.effectValue) %></td>
  <td><%= formatNumber(item.price) %> gold</td>
  <td>
    <%- include("./cart-quantity", {
      fieldId: `item-${item.id}`, itemId: item.id,
      label: `Quantity of ${item.name}`, price: item.price,
    }) %>
  </td>
</tr>
