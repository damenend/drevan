<section class="page">
  <h2>The Quarters</h2>

  <%- include("../partials/location-image", {
    src: "/images/home.webp",
    caption: "A cozy stone-and-timber cottage with glowing windows and futuristic technology.",
  }) %>

  <p>Welcome back, <%= formatPlayerName(user.name) %>!</p>

  <section class="character" aria-labelledby="character-heading">
    <h3 id="character-heading">Character Overview</h3>

    <%- include("../partials/player-avatar", { player: user }) %>

    <dl class="character-stats">
      <div class="character-stat">
        <dt>Health</dt>
        <dd><%= formatNumber(user.hp) %> / <%= formatNumber(user.maxHp) %></dd>
      </div>

      <div class="character-stat">
        <dt>Gold</dt>
        <dd><%= formatNumber(user.gold) %></dd>
      </div>

      <div class="character-stat">
        <dt>Combat Strength</dt>
        <dd><%- include("../partials/stat-total", { total: effectiveStats.strength, base: attributes.strength }) %></dd>
      </div>

      <div class="character-stat">
        <dt>Speed</dt>
        <dd><%= formatNumber(attributes.agility) %></dd>
      </div>

      <div class="character-stat">
        <dt>Defense</dt>
        <dd><%- include("../partials/stat-total", { total: effectiveStats.defense, base: user.defense }) %></dd>
      </div>

      <div class="character-stat">
        <dt>Level</dt>
        <dd><%= formatNumber(progression.level) %></dd>
      </div>

      <div class="character-stat">
        <% if (progression.nextLevelXp === null) { %>
        <dt>Lifetime experience</dt>
        <dd><%= formatNumber(user.exp) %></dd>
        <% } else { %>
        <dt>Experience</dt>
        <dd><%= formatNumber(progression.currentLevelXp) %> / <%= formatNumber(progression.nextLevelXp) %></dd>
        <% } %>
      </div>

      <div class="character-stat">
        <dt>Unspent stat points</dt>
        <dd><%= formatNumber(progression.unspentPoints) %></dd>
      </div>
    </dl>

    <h4>Primary Attributes</h4>
    <dl class="character-stats">
      <div class="character-stat">
        <dt>Strength</dt>
        <dd><%= formatNumber(attributes.strength) %></dd>
      </div>
      <div class="character-stat">
        <dt>Agility</dt>
        <dd><%= formatNumber(attributes.agility) %></dd>
      </div>
      <div class="character-stat">
        <dt>Intellect</dt>
        <dd><%= formatNumber(attributes.intellect) %></dd>
      </div>
      <div class="character-stat">
        <dt>Fortitude</dt>
        <dd><%= formatNumber(attributes.fortitude) %></dd>
      </div>
    </dl>

    <%- include("../partials/stat-allocation") %>
  </section>

  <% if (message) { %>
  <p role="status"><%= message %></p>
  <% } %>

  <section id="equipped" aria-labelledby="equipped-heading">
    <h3 id="equipped-heading">Equipped</h3>

    <% if (equipped.length === 0) { %>
    <p>You have no equipment equipped.</p>
    <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Slot</th>
            <th scope="col">Item</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <% for (const slot of ["weapon", "armor"]) {
            const item = equipped.find(item => item.equippedSlot === slot);
          %>
          <tr>
            <th scope="row"><%= slot === "weapon" ? "Weapon" : "Armor" %></th>
            <% if (item) { %>
            <td><%- include("../partials/item-figure", { item }) %></td>
            <td>
              <form action="/game/inventory/unequip" method="POST">
                <input type="hidden" name="itemId" value="<%= item.id %>">
                <button type="submit" aria-label="Unequip <%= item.name %>">Unequip</button>
              </form>
            </td>
            <% } else { %>
            <td>Empty</td>
            <td>—</td>
            <% } %>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>

  <section class="inventory" aria-labelledby="inventory-heading">
    <h3 id="inventory-heading">Inventory</h3>

    <% if (inventory.length === 0) { %>
    <p>Your inventory is empty.</p>
    <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Description</th>
            <th scope="col">Quantity</th>
            <th scope="col">Effect</th>
            <th scope="col">Effect Value</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <% inventory.forEach(item => { %>
          <tr>
            <td>
              <%- include("../partials/item-figure", { item }) %>
            </td>
            <td><%= item.description %></td>
            <td><%= formatNumber(item.quantity) %></td>
            <td><%= item.effect %></td>
            <td><%= item.effectValue === null ? "—" : formatNumber(item.effectValue) %></td>
            <td>
              <%
                let action;
                if (item.type === "consumable") {
                  action = "Use";
                } else if (!item.equippedSlot && (item.type === "weapon" || item.type === "armor")) {
                  action = "Equip";
                }
              %>
              <% if (action) { %>
              <form action="/game/inventory/<%= action.toLowerCase() %>" method="POST">
                <input type="hidden" name="itemId" value="<%= item.id %>">
                <button type="submit" aria-label="<%= action %> <%= item.name %>">
                  <%= action %>
                </button>
              </form>
              <% } else { %>
              <span class="text-muted">—</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</section>
