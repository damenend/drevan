<section class="quarters">
  <h1>The Quarters</h1>

  <div class="quarters-intro">
    <%- include("../partials/location-image", {
      src: "/images/home.webp",
      width: 1672,
      height: 941,
      flush: true,
      compact: true,
      alt: "A stone-and-timber cottage with lit windows and machinery outside.",
      caption: "A place of your own in Nexaris.",
    }) %>
    <div>
      <p class="quarters-welcome">Welcome back, <%= formatPlayerName(user.name) %>.</p>
      <p>There’s room here to stow your gear and prepare for the next outing.</p>
    </div>
  </div>

  <% if (message) { %>
  <p tabindex="-1" data-result-focus><%= message %></p>
  <% } %>

  <section aria-labelledby="character-heading">
    <h2 id="character-heading" tabindex="-1">Character overview</h2>
    <div class="quarters-overview">
      <div class="quarters-identity">
        <%- include("../partials/player-avatar", { player: user, inline: true }) %>
        <div>
          <p class="quarters-name"><%= formatPlayerName(user.name) %></p>
          <p class="text-muted">Level <%= formatNumber(progression.level) %> · <%= formatPlayerName(user.characterClass) %></p>
        </div>
      </div>

      <div class="quarters-details">
        <%- include("../partials/health-meter", { id: "quarters-hp" }) %>

        <dl class="character-stats character-stats--compact<%= progression.nextLevelXp !== null ? ' character-stats--three' : '' %>">
          <div class="character-stat quarters-gold">
            <dt>Gold</dt>
            <dd><%= formatNumber(user.gold) %></dd>
          </div>
          <div class="character-stat">
            <dt>Lifetime XP</dt>
            <dd><%= formatNumber(user.exp) %></dd>
          </div>
          <% if (progression.nextLevelXp !== null) { %>
          <div class="character-stat">
            <dt>XP toward next level</dt>
            <dd><%= formatNumber(progression.currentLevelXp) %> / <%= formatNumber(progression.nextLevelXp) %></dd>
          </div>
          <% } %>
        </dl>

        <section aria-labelledby="combat-stats-heading">
          <h3 class="section-heading" id="combat-stats-heading">Combat stats</h3>
          <dl class="character-stats character-stats--compact character-stats--three">
            <div class="character-stat">
              <dt>Attack Power</dt>
              <dd><%- include("../partials/stat-total", { total: effectiveStats.attackPower, base: baseAttackPower }) %></dd>
            </div>

            <div class="character-stat">
              <dt>Speed</dt>
              <dd><%= formatNumber(effectiveStats.speed) %></dd>
            </div>

            <div class="character-stat">
              <dt>Defense</dt>
              <dd><%- include("../partials/stat-total", { total: effectiveStats.defense, base: user.defense }) %></dd>
            </div>
          </dl>
          <p class="quarters-support">Speed affects who attacks first and how often they attack. Defense reduces damage taken.</p>
        </section>

        <section aria-labelledby="primary-attributes-heading">
          <div class="quarters-attributes-heading">
            <h3 class="section-heading" id="primary-attributes-heading">Primary attributes</h3>
            <p class="quarters-support"><%= formatNumber(progression.unspentPoints) %> unspent attribute <%= progression.unspentPoints === 1 ? "point" : "points" %></p>
          </div>
          <dl class="character-stats character-stats--compact character-stats--attributes">
            <div class="character-stat">
              <dt>Strength</dt>
              <dd><%= formatNumber(attributes.strength) %></dd>
            </div>
            <div class="character-stat">
              <dt>Agility</dt>
              <dd><%= formatNumber(attributes.agility) %></dd>
            </div>
            <div class="character-stat">
              <dt>Intellect</dt>
              <dd><%= formatNumber(attributes.intellect) %></dd>
            </div>
            <div class="character-stat">
              <dt>Fortitude</dt>
              <dd><%= formatNumber(attributes.fortitude) %></dd>
            </div>
          </dl>
          <p class="quarters-support">Strength, Agility, and Intellect each add 1 Attack Power per point. Fortitude adds 3 max HP per point.</p>
          <%- include("../partials/stat-allocation") %>
        </section>
      </div>
    </div>
  </section>

  <section id="equipped" tabindex="-1" aria-labelledby="equipped-heading">
    <h2 id="equipped-heading">Equipment</h2>
    <div class="quarters-equipment">
      <% for (const { slot, item } of equipment) { %>
      <section class="equipment-slot" aria-labelledby="slot-<%= slot %>">
        <h3 class="section-heading" id="slot-<%= slot %>"><%= formatPlayerName(slot) %></h3>
        <% if (item) { %>
        <%- include("../partials/item-figure", { item }) %>
        <%- include("../partials/item-effect", { effect: describeItemEffect(item.effect, item.effectValue) }) %>
        <form action="/game/inventory/unequip<%= actionQuery %>" method="POST">
          <input type="hidden" name="itemId" value="<%= item.id %>">
          <button type="submit" class="button--secondary" aria-label="Unequip <%= item.name %>">Unequip</button>
        </form>
        <% } else { %>
        <p class="quarters-support">No <%= slot %> equipped.</p>
        <% } %>
      </section>
      <% } %>
    </div>
  </section>

  <section aria-labelledby="inventory-heading">
    <h2 id="inventory-heading" tabindex="-1">Inventory</h2>
    <nav class="link-nav link-nav--filters" aria-label="Inventory categories">
      <% for (const [key, label] of Object.entries(inventoryCategories)) { %>
      <a href="/game<%= key === "all" ? "" : "?category=" + key %>#inventory-heading"<% if (category === key) { %> aria-current="page"<% } %>><%= label %></a>
      <% } %>
    </nav>

    <% if (inventoryEmpty) { %>
    <p>Your inventory is empty.</p>
    <% } else if (inventory.length === 0) { %>
    <p>No items in this category.</p>
    <% } else { %>
    <div class="table-responsive" data-scroll-label="Inventory items">
      <table class="table quarters-inventory" aria-labelledby="inventory-heading">
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Quantity</th>
            <th scope="col">Effect</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <% for (const item of inventory) { %>
          <tr>
            <th scope="row"><%- include("../partials/item-figure", { item, showDescription: true }) %></th>
            <td class="quarters-quantity">
              <%= formatNumber(item.quantity) %>
            </td>
            <td>
              <% const effect = describeItemEffect(item.effect, item.effectValue); %>
              <% if (effect) { %>
              <%- include("../partials/item-effect", { effect }) %>
              <% } else { %>
              <span class="text-muted">—</span>
              <% } %>
            </td>
            <td>
              <% if (item.action) { %>
              <form action="/game/inventory/<%= item.action.toLowerCase() %><%= actionQuery %>" method="POST">
                <input type="hidden" name="itemId" value="<%= item.id %>">
                <button type="submit" aria-label="<%= item.action %> <%= item.name %>"><%= item.action %></button>
              </form>
              <% } else { %>
              <span class="text-muted">—</span>
              <% } %>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</section>
