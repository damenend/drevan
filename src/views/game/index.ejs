<section class="page">
  <h2>Welcome back, <%= formatPlayerName(user.name) %>!</h2>

  <%- include("../partials/location-image", {
    src: "/images/home.webp",
    caption: "A cozy stone-and-timber cottage with glowing windows and futuristic technology.",
  }) %>

  <section class="character" aria-labelledby="character-heading">
    <h3 id="character-heading">Character Overview</h3>

    <dl class="character-stats">
      <div class="character-stat">
        <dt>Health</dt>
        <dd><%= formatNumber(user.hp) %> / <%= formatNumber(user.maxHp) %></dd>
      </div>

      <div class="character-stat">
        <dt>Gold</dt>
        <dd><%= formatNumber(user.gold) %></dd>
      </div>

      <div class="character-stat">
        <dt>Strength</dt>
        <dd><%- include("../partials/stat-total", { total: effectiveStats.strength, base: user.strength }) %></dd>
      </div>

      <div class="character-stat">
        <dt>Speed</dt>
        <dd><%= formatNumber(user.speed) %></dd>
      </div>

      <div class="character-stat">
        <dt>Defense</dt>
        <dd><%- include("../partials/stat-total", { total: effectiveStats.defense, base: user.defense }) %></dd>
      </div>

      <div class="character-stat">
        <dt>Experience</dt>
        <dd><%= formatNumber(user.exp) %></dd>
      </div>
    </dl>
  </section>

  <section class="inventory" aria-labelledby="inventory-heading">
    <h3 id="inventory-heading">Inventory</h3>

    <% if (message) { %>
    <p role="status"><%= message %></p>
    <% } %>

    <% if (inventory.length === 0) { %>
    <p>Your inventory is empty.</p>
    <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Description</th>
            <th scope="col">Quantity</th>
            <th scope="col">Effect</th>
            <th scope="col">Effect Value</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
          <% inventory.forEach(item => { %>
          <tr>
            <td>
              <%- include("../partials/item-figure", { item }) %>
            </td>
            <td><%= item.description %></td>
            <td><%= formatNumber(item.quantity) %></td>
            <td><%= item.effect %></td>
            <td><%= item.effectValue === null ? "—" : formatNumber(item.effectValue) %></td>
            <td>
              <%
                const isEquipped =
                  item.id === user.equippedWeaponId ||
                  item.id === user.equippedArmorId;

                let action;
                if (item.type === "consumable") {
                  action = "Use";
                } else if (item.type === "weapon" || item.type === "armor") {
                  action = isEquipped ? "Unequip" : "Equip";
                }
              %>
              <% if (action) { %>
              <form action="/game/inventory/<%= action.toLowerCase() %>" method="POST">
                <input type="hidden" name="itemId" value="<%= item.id %>">
                <button type="submit" aria-label="<%= action %> <%= item.name %>">
                  <%= action %>
                </button>
              </form>
              <% } else { %>
              <span class="text-muted">—</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>
</section>
