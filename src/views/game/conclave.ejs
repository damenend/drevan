<section aria-labelledby="conclave-heading">
  <h1 id="conclave-heading">The Conclave</h1>

  <%- include("../partials/location-image", {
    src: "/images/conclave.webp",
    width: 1672,
    height: 941,
    caption: "Three stone figures stand beneath a suspended blue crystal.",
  }) %>

  <p>The Conclave keeps three combat disciplines beneath its vaulted hall.</p>

  <p>Current level: <%= formatNumber(level) %></p>

  <% if (message) { %>
  <p tabindex="-1" data-result-focus><%= message %></p>
  <% } %>

  <% if (level < 10) { %>
  <p>Class selection opens at level 10. Return after earning more XP.</p>
  <% } else { %>
  <% if (user.characterClass === 'unaligned') { %>
  <p>You are currently Unaligned.</p>
  <% } else { %>
  <p>Current class: <%= formatCharacterClass(user.characterClass) %></p>
  <% } %>
  <form class="conclave-class-form" action="/game/conclave" method="POST">
    <fieldset class="choice-group choice-group--prominent">
      <legend>Choose your class</legend>
      <p id="class-selection-note" class="text-muted">
        The Conclave preserves three ancient disciplines. Choose the path
        that best reflects your approach to combat. Your preferred attribute
        grants 3 Attack Power per point instead of 1. You may return and
        change your class later.
      </p>

      <div class="choice-grid choice-grid--three">
        <label class="choice-card conclave-class-option" for="vanguard">
          <span class="conclave-class-option__heading">
            <input type="radio" name="characterClass" id="vanguard" value="vanguard" required aria-describedby="vanguard-description class-selection-note" <% if (user.characterClass === 'melee') { %>checked disabled<% } %> />
            <span>Vanguard</span>
            <% if (user.characterClass === 'melee') { %><span class="conclave-class-option__current">Current class</span><% } %>
          </span>
          <span id="vanguard-description" class="conclave-class-option__description">
            Master the art of close-quarters combat, overcoming adversaries
            through raw power and martial prowess.
          </span>
          <span class="conclave-class-option__attribute">Preferred attribute: <strong>Strength</strong></span>
        </label>

        <label class="choice-card conclave-class-option" for="arcanist">
          <span class="conclave-class-option__heading">
            <input type="radio" name="characterClass" id="arcanist" value="arcanist" required aria-describedby="arcanist-description class-selection-note" <% if (user.characterClass === 'caster') { %>checked disabled<% } %> />
            <span>Arcanist</span>
            <% if (user.characterClass === 'caster') { %><span class="conclave-class-option__current">Current class</span><% } %>
          </span>
          <span id="arcanist-description" class="conclave-class-option__description">
            Harness the enigmatic energies of the old world, bending
            forgotten forces to your will.
          </span>
          <span class="conclave-class-option__attribute">Preferred attribute: <strong>Intellect</strong></span>
        </label>

        <label class="choice-card conclave-class-option" for="ranger">
          <span class="conclave-class-option__heading">
            <input type="radio" name="characterClass" id="ranger" value="ranger" required aria-describedby="ranger-description class-selection-note" <% if (user.characterClass === 'ranged') { %>checked disabled<% } %> />
            <span>Ranger</span>
            <% if (user.characterClass === 'ranged') { %><span class="conclave-class-option__current">Current class</span><% } %>
          </span>
          <span id="ranger-description" class="conclave-class-option__description">
            Strike from afar, relying on precision, dexterity,
            and calculated execution.
          </span>
          <span class="conclave-class-option__attribute">Preferred attribute: <strong>Agility</strong></span>
        </label>
      </div>
    </fieldset>

    <button type="submit">Choose class</button>
  </form>
  <% } %>
</section>
