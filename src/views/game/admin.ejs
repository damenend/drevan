<section class="page">
  <h3>Admin portal</h3>

  <% if (message === 'err') { %>
  <p role="status">An error occurred.</p>
  <% } else if (message === 'success') { %>
  <p role="status">Update successful.</p>
  <% } %>

  <form action="/game/admin" method="POST">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Stat</th>
            <th scope="col">Value</th>
          </tr>
        </thead>

        <tbody>
          <% editableStats.forEach(key => { %>
          <tr>
            <td><label for="<%= key %>"><%= key === "fishing_casts_used" ? "Fishing casts used today" : key %></label></td>
            <td>
              <input type="number" id="<%= key %>" name="stats[<%= key %>]" value="<%= statValues[key] %>" min="0" step="1" <% if (key === "fishing_casts_used") { %>max="<%= dailyCastLimit %>" required<% } %>>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <button type="submit">Update</button>
  </form>
</section>
