<section class="page">
  <h2>Admin portal</h2>

  <% if (message === 'err') { %>
  <p role="status">An error occurred.</p>
  <% } else if (message === 'success') { %>
  <p role="status">Update successful.</p>
  <% } %>

  <p>Class: <strong><%= formatPlayerName(user.characterClass) %></strong></p>
  <p>Attack Power: <strong><%= formatNumber(effectiveStats.attackPower) %></strong></p>
  <p>Speed: <strong><%= formatNumber(effectiveStats.speed) %></strong></p>
  <p>Current HP: <strong><%= formatNumber(user.hp) %></strong></p>
  <p>Effective max HP: <strong><%= formatNumber(user.maxHp) %></strong></p>
  <p>Total Fortitude: <%= formatNumber(fortitude) %>. Each point adds <%= formatNumber(hpPerFortitude) %> max HP. Changing Base Fortitude refills current HP to the new cap.</p>

  <form action="/game/admin" method="POST">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Stat</th>
            <th scope="col">Value</th>
          </tr>
        </thead>

        <tbody>
          <% editableStats.forEach(key => { %>
          <tr>
            <th scope="row"><label for="<%= key %>"><%= statLabels[key] %></label></th>
            <td>
              <input type="number" id="<%= key %>" name="stats[<%= key %>]" value="<%= statValues[key] %>" min="0" step="1" required <% if (key === "fishing_casts_used") { %>max="<%= dailyCastLimit %>"<% } %>>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <button type="submit">Update</button>
  </form>
</section>
