<section class="page">
  <h3>Admin portal</h3>

  <% if (message === 'err') { %>
  <p role="status">An error occurred.</p>
  <% } else if (message === 'success') { %>
  <p role="status">Update successful.</p>
  <% } %>

  <form action="/game/admin" method="POST">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Stat</th>
            <th scope="col">Value</th>
          </tr>
        </thead>

        <tbody>
          <% editableStats.forEach(key => { %>
          <tr>
            <td><label for="<%= key %>"><%= key === "fishing_casts_used" ? "Fishing casts used today" : key === "maxHp" ? "Base max HP" : key === "strength" ? "Base Strength" : key === "speed" ? "Base Speed" : key %></label></td>
            <td>
              <input type="number" id="<%= key %>" name="stats[<%= key %>]" value="<%= statValues[key] %>" min="0" step="1" required <% if (key === "fishing_casts_used") { %>max="<%= dailyCastLimit %>"<% } else if (key === "maxHp") { %>aria-describedby="max-hp-help"<% } %>>
              <% if (key === "maxHp") { %>
              <p id="max-hp-help">The Quarters shows base max HP plus <%= formatNumber(user.maxHp - user.baseMaxHp) %> HP from spent attribute points. Changing base max HP also sets current HP to the new total.</p>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <button type="submit">Update</button>
  </form>
</section>
