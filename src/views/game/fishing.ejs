<section class="page">
  <h2><%= title %></h2>
  <div class="driftwater-layout">
    <section class="driftwater-fishing" aria-labelledby="driftwater-fishing-heading">
      <h3 id="driftwater-fishing-heading">Fishing</h3>
      <form action="/game/fishing" method="POST">
        <div class="driftwater-availability">
          <div class="driftwater-casts">
            <label for="driftwater-cast-meter">Daily casts remaining</label>
            <span aria-hidden="true"><%= formatNumber(castsRemaining) %> / <%= formatNumber(dailyCastLimit) %></span>
          </div>
          <meter id="driftwater-cast-meter" min="0" max="<%= dailyCastLimit %>" value="<%= castsRemaining %>" aria-valuetext="<%= formatNumber(castsRemaining) %> of <%= formatNumber(dailyCastLimit) %>" aria-describedby="driftwater-reset"></meter>
          <p id="driftwater-reset" class="text-muted">Resets daily at midnight Central Time.</p>
        </div>
        <button type="submit"<% if (castsRemaining === 0) { %> disabled<% } %>>Cast line</button>
        <% if (castsRemaining === 0) { %>
        <p class="driftwater-exhausted text-muted">You've used all your casts for today.</p>
        <% } %>
      </form>

      <section class="driftwater-result" aria-labelledby="driftwater-last-cast">
        <h4 id="driftwater-last-cast">Last cast</h4>
        <% if (report?.kind === "caught") { %>
        <div class="item-group">
          <% if (report.image) { %>
          <img src="<%= report.image %>" alt="" width="88" height="88" class="item-icon">
          <% } %>
          <div>
            <strong><%= report.name %></strong>
            <p>You reel in a <%= report.name %>.</p>
          </div>
        </div>
        <% } else if (report?.kind === "released") { %>
        <strong>Fish released</strong>
        <p>You released the <strong><%= report.name %></strong> because you can’t carry any more of that fish.</p>
        <% } else if (report?.kind === "empty") { %>
        <strong>No catch</strong>
        <p>Your line comes back empty.</p>
        <% } else { %>
        <p class="text-muted">Cast your line into the shallows to see what bites.</p>
        <% } %>
      </section>
    </section>

    <div class="driftwater-location">
      <%- include("../partials/location-image", {
        src: "/images/the-driftwater.webp",
        alt: "Glowing water laps against old stonework beneath a sky filled with distant worlds.",
        caption: "The shallows at The Driftwater.",
      }) %>
      <p>Beyond Nexaris, water glows where it meets the old stonework. Anglers keep to the shallows and let the deeper water keep its secrets.</p>
    </div>
  </div>
</section>
