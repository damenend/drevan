<section>
  <h1<% if (dead) { %> tabindex="-1" data-result-focus<% } %>>Dominion training</h1>
  <% if (dead) { %>
  <%- include("../partials/arena-heal-notice") %>
  <% } else { %>
  <%- include("../partials/battle-log", { battleHeadingLevel: 2, focusBattleSummary: true, enemyName: `Level ${formatNumber(level)} Training Dummy` }) %>
  <% if (gainedLevel !== null) { %>
  <p>You reached level <%= formatNumber(gainedLevel) %>. <a href="/game#character-heading">Spend attribute points in The Quarters</a>.</p>
  <% } %>
  <a href="/game/arena?level=<%= level %>">Return to Dominion</a>
  <% } %>
</section>
