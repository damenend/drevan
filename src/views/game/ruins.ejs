<section aria-labelledby="ruins-heading">
  <h1 id="ruins-heading">The Ruins</h1>
  <% if (position === null) { %>
  <%- include("../partials/location-image", {
    src: "/images/drevan-ruins-banner.webp",
    caption: "The entrance to Floor 1 of The Ruins.",
    banner: {
      alt: "Blue runes line a stone archway opening into darkness.",
      width: 1774,
      height: 887,
    },
  }) %>

  <% if (message) { %>
  <p tabindex="-1" data-result-focus<% if (discovery) { %> class="ruins-notice ruins-notice--discovery"<% } %>><% if (discovery) { %><strong>Discovery.</strong> <% } %><%= message %></p>
  <% } %>
  <p>Old stone and buried machinery lie beyond the entrance. Set your equipment before you enter.</p>
  <% if (user.hp > 0) { %>
  <form action="/game/ruins/action" method="post">
    <input type="hidden" name="revision" value="<%= user.ruinsRevision %>">
    <button type="submit" name="action" value="enter">Enter The Ruins</button>
  </form>
  <% } else { %>
  <p><a href="/game/hospital">Heal at Sanctum</a> before entering.</p>
  <% } %>
  <% } else { %>
  <div class="activity-layout activity-layout--ruins">
    <div class="ruins-exploration">
      <div class="ruins-floor">
        <h2 id="ruins-floor">Floor 1</h2>
        <p>Position (<%= position % size %>, <%= Math.floor(position / size) %>)</p>
      </div>

      <div class="ruins-navigation">
        <% const visibleMarkers = []; %>
        <% const directions = new Map([[position - size, "north"], [position + size, "south"], [position - 1, "west"], [position + 1, "east"]]); %>
        <% /** Shares the visible marker metadata between map tiles and the marker list. */
        function tileDetails(tile) {
          const coordinates = `(${tile % size}, ${Math.floor(tile / size)})`;
          const enemy = hasEnemy(tile);
          const [symbol, description] = tile === entrance ? ["E", "entrance and exit"] : tile === nextFloorMarker ? ["2", "Floor 2 entrance"] : enemy ? ["X", "enemy encounter"] : ["", ""];
          const style = "ruins-tile" + (tile === entrance ? " ruins-tile--exit" : tile === nextFloorMarker ? " ruins-tile--stairs" : enemy ? " ruins-tile--enemy" : "");
          return { coordinates, symbol, description, style };
        } %>
        <% const current = tileDetails(position); %>
        <form class="ruins-map" data-ruins-map data-position="<%= position %>" data-size="<%= size %>"<% if (restoreMapFocus) { %> data-restore-focus<% } %> action="/game/ruins/action" method="post" aria-label="Move to an adjacent square">
          <input type="hidden" name="revision" value="<%= user.ruinsRevision %>">
          <input type="hidden" name="action" value="move">
          <span class="<%= current.style %> ruins-tile--player" data-player-tile role="img" aria-label="Your position <%= current.coordinates %><%= current.description ? ', ' + current.description : '' %>" tabindex="0" style="grid-area: <%= Math.floor(position / size) + 1 %> / <%= position % size + 1 %>" aria-describedby="ruins-map-keys ruins-tile-feedback">P<%= current.symbol %></span>
          <% for (let tile = 0; tile < size ** 2; tile++) { %>
          <% if (tile === position) continue;
          const { coordinates, symbol, description, style } = tileDetails(tile);
          if (description) visibleMarkers.push(`${coordinates}, ${description}`); %>
          <% if (canMove(position, tile)) { %>
          <button class="<%= style %>" type="submit" name="destination" value="<%= tile %>" aria-label="Move <%= directions.get(tile) %> to <%= coordinates %><%= description ? ', ' + description : '' %>"><%= symbol || "·" %></button>
          <% } else { %>
          <span class="<%= style %>" aria-hidden="true"><%= symbol %></span>
          <% } %>
          <% } %>
        </form>
        <script src="/js/ruins-map.js" defer></script>
        <p class="ruins-map-legend">P: Player · E: Exit<% if (nextFloorMarker !== null) { %> · 2: Floor 2<% } %> · X: Enemy</p>
        <p id="ruins-map-keys" class="ruins-map-legend">Use Tab to choose a move. Press Enter or Space to move.</p>
        <% if (visibleMarkers.length) { %>
        <details class="ruins-map-legend">
          <summary>Map markers</summary>
          <ul>
            <% for (const marker of visibleMarkers) { %>
            <li><%= marker %></li>
            <% } %>
          </ul>
        </details>
        <% } %>
      </div>

      <section class="ruins-surroundings" aria-labelledby="ruins-surroundings">
        <h2 id="ruins-surroundings">Surroundings</h2>
        <div id="ruins-tile-feedback"<% if (!restoreMapFocus && message && !battle) { %> tabindex="-1" data-result-focus<% } %>>
          <% if (message) { %>
          <p<% if (discovery) { %> class="ruins-notice ruins-notice--discovery"<% } %>><% if (discovery) { %><strong>Discovery.</strong> <% } %><%= message %></p>
          <% } %>
          <% if (encounter) { %>
          <p class="ruins-notice ruins-notice--encounter"><strong>Enemy sighted.</strong> Fight it or pass by.</p>
          <% } else if (atNextFloor) { %>
          <p class="ruins-notice ruins-notice--discovery"><strong>Floor 2 entrance discovered.</strong> The way down is sealed.</p>
          <% } else if (emptySquare && !message) { %>
          <p class="ruins-empty">There’s nothing to do here.</p>
          <% } %>
        </div>
        <% if (position === entrance || atNextFloor || encounter) { %>
        <form class="ruins-actions" action="/game/ruins/action" method="post">
          <input type="hidden" name="revision" value="<%= user.ruinsRevision %>">
          <% if (position === entrance) { %>
          <button type="submit" name="action" value="exit">Return to Nexaris</button>
          <% } else if (atNextFloor) { %>
          <button type="button" disabled>Descend to Floor 2</button>
          <% } %>
          <% if (encounter) { %>
          <h3 class="section-heading"><%= encounter.enemy.name %></h3>
          <p><%= encounter.description %></p>
          <button type="submit" name="action" value="engage">Fight</button>
          <button type="submit" name="action" value="ignore">Pass by</button>
          <% } %>
        </form>
        <% } %>

        <% if (battle) { %>
        <%- include("../partials/battle-log", { ...battle, focusBattleSummary: true }) %>
        <% } %>
      </section>
    </div>

    <div class="ruins-controls">
      <%- include("../partials/location-image", {
        src: "/images/drevan-ruins-interior.webp",
        width: 959,
        height: 540,
        flush: true,
        alt: "Blue crystals light a stone passage.",
      }) %>

      <%- include("../partials/health-meter", { id: "ruins-hp" }) %>

      <section aria-labelledby="ruins-character">
        <h2 id="ruins-character">Character</h2>
        <dl class="ruins-stats">
          <dt>Level</dt>
          <dd><%= formatNumber(progression.level) %></dd>
          <dt>Fortitude</dt>
          <dd><%= formatNumber(attributes.fortitude) %></dd>
          <dt>Lifetime XP</dt>
          <dd><%= formatNumber(user.exp) %></dd>
          <% if (progression.nextLevelXp !== null) { %>
          <dt>XP toward next level</dt>
          <dd><%= formatNumber(progression.currentLevelXp) %> / <%= formatNumber(progression.nextLevelXp) %></dd>
          <% } %>
          <dt>Unspent attribute points</dt>
          <dd><%= formatNumber(progression.unspentPoints) %></dd>
          <dt>Gold</dt>
          <dd class="ruins-gold"><%= formatNumber(user.gold) %></dd>
        </dl>
        <%- include("../partials/stat-allocation") %>
      </section>

      <section aria-labelledby="ruins-items">
        <h2 id="ruins-items">Consumables</h2>
        <% if (!potions.length) { %>
        <p>You have no healing potions.</p>
        <% } else { %>
        <form action="/game/inventory/use" method="post" aria-label="Use a healing potion">
          <ul class="ruins-consumables">
            <% for (const potion of potions) { %>
            <li>
              <%- include("../partials/item-figure", { item: potion, compact: true, itemQuantity: potion.quantity }) %>
              <button type="submit" name="itemId" value="<%= potion.id %>" aria-label="Use <%= potion.name %>">Use</button>
            </li>
            <% } %>
          </ul>
        </form>
        <% } %>
      </section>

      <section aria-labelledby="ruins-beacon">
        <h2 id="ruins-beacon">Recall Beacon</h2>
        <% if (hasBeacon && !recalledToday) { %>
        <p>Recall Beacon available.</p>
        <% } else if (hasBeacon) { %>
        <p>Recall Beacon on cooldown until midnight Central time.</p>
        <% } else { %>
        <p>You do not have a Recall Beacon.</p>
        <% } %>
        <form action="/game/ruins/action" method="post">
          <input type="hidden" name="revision" value="<%= user.ruinsRevision %>">
          <button class="button--secondary" type="submit" name="action" value="recall"<% if (!hasBeacon || recalledToday) { %> disabled<% } %>>Activate Recall Beacon</button>
        </form>
      </section>
    </div>
  </div>
  <% } %>
</section>
