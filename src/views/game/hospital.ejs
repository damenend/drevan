<section class="page">
  <h3>Welcome to <%= title %>!</h3>

  <%- include("../partials/location-image", {
    src: "/images/sanctum.webp",
    caption: "A futuristic healing sanctuary with glowing blue windows and a domed stone entrance.",
  }) %>

  <%- include("../partials/player-gold", { gold: user.gold }) %>

  <% if (message) { %>
  <p><%= message %></p>
  <% } %>

  <% if (user.hp >= user.maxHp) { %>
  <p>You're currently at full health.</p>
  <% } else { %>
  <p>Current cost: <%= cost %></p>

  <% if (cost > user.gold) { %>
  <p>You can't currently afford to heal.</p>
  <% } else { %>
  <form action="/game/hospital" method="POST">
    <button type="submit">Heal</button>
  </form>
  <% } %>
  <% } %>
</section>