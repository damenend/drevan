<section>
  <h1><%= title %></h1>

  <%- include("../partials/location-image", {
    src: "/images/sanctum.webp",
    width: 1672,
    height: 941,
    alt: "Blue-lit windows flank a domed stone entrance.",
    caption: "The entrance to Sanctum.",
  }) %>

  <p>Old healing apparatus hums in the quiet halls of Sanctum. The attendants charge 1 gold for each HP restored.</p>

  <%- include("../partials/player-gold", { gold: user.gold }) %>

  <% if (message) { %>
  <p tabindex="-1" data-result-focus><%= message %></p>
  <% } %>

  <% if (user.hp >= user.maxHp) { %>
  <p>You’re at full health.</p>
  <% } else { %>
  <p>Healing costs <%= formatNumber(cost) %> gold.</p>

  <% if (cost > user.gold) { %>
  <p>You do not have enough gold to heal.</p>
  <% } else { %>
  <form action="/game/hospital" method="POST">
    <button type="submit">Heal</button>
  </form>
  <% } %>
  <% } %>
</section>
