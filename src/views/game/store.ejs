<section class="page">
  <h3>Welcome to <%= title %>!</h3>
  <%- include("../partials/location-image", {
    src: "/images/curious-emporium.webp",
    caption: "A fantasy marketplace filled with glowing crystals and merchant supplies beneath a bronze dome.",
  }) %>
  <%- include("../partials/player-gold", { gold: user.gold }) %>
  <h4>Buy items</h4>
  <form action="/game/store" method="POST">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Description</th>
            <th scope="col">Effect</th>
            <th scope="col">Effect Value</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr>
            <td>
              <%- include("../partials/item-figure", { item }) %>
            </td>
            <td><%= item.description %></td>
            <td><%= item.effect %></td>
            <td><%= item.effectValue === null ? "—" : formatNumber(item.effectValue) %></td>
            <td><%= formatNumber(item.price) %> gold</td>
            <td>
              <label for="item-<%= item.id %>" class="visually-hidden">
                Quantity of <%= item.name %>
              </label>
              <input type="number" id="item-<%= item.id %>" name="items[item-<%= item.id %>]" value="0" min="0" step="1" data-price="<%= item.price %>" class="item-quantity">
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p>
      Total:
      <output id="total-gold" aria-live="polite">0</output> gold
    </p>
    <p id="purchase-message" class="err" aria-live="polite">
      <%= err || "" %>
    </p>
    <button type="submit" id="purchase-button" class="button">Purchase</button>
  </form>
  <section id="sell" aria-labelledby="sell-heading">
    <h4 id="sell-heading">Sell items</h4>
    <% if (sold) { %>
    <p role="status">Sale complete.</p>
    <% } %>
    <% if (sellableItems.length === 0) { %>
    <p>You have no items Curious Emporium buys.</p>
    <% } else { %>
    <form id="sell-form" action="/game/store/sell" method="POST">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Available</th>
              <th scope="col">Value</th>
              <th scope="col">Sell quantity</th>
            </tr>
          </thead>
          <tbody>
            <% sellableItems.forEach(item => { %>
            <tr>
              <th scope="row">
                <%- include("../partials/item-figure", { item }) %>
              </th>
              <td><%= formatNumber(item.available) %></td>
              <td><%= formatNumber(item.sellPrice) %></td>
              <td>
                <% if (item.available === 0) { %>
                <a href="/game#equipped">Unequip in The Quarters</a>
                <% } else { %>
                <label for="sell-<%= item.id %>" class="visually-hidden">Quantity of <%= item.name %> to sell</label>
                <input type="number" id="sell-<%= item.id %>" name="items[item-<%= item.id %>]" value="0" min="0" max="<%= item.available %>" step="1" data-price="<%= item.sellPrice %>">
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (sellableItems.some(item => item.available > 0)) { %>
      <p>
        Sell for
        <output id="sell-total" aria-live="polite">0</output> gold
      </p>
      <button type="submit" id="sell-button" class="button">Sell</button>
      <% } %>
    </form>
    <% } %>
  </section>
</section>

<script>
  const quantityInputs = document.querySelectorAll(".item-quantity");
  const totalGold = document.querySelector("#total-gold");
  const playerGold = document.querySelector("#player-gold");
  const purchaseMessage = document.querySelector("#purchase-message");
  const purchaseButton = document.querySelector("#purchase-button");

  const availableGold = Number(playerGold.dataset.gold);

  function getTotal(inputs) {
    let total = 0;

    inputs.forEach((input) => {
      const price = Number(input.dataset.price);
      const quantity = Number(input.value) || 0;

      total += price * quantity;
    });

    return total;
  }

  function updatePurchaseTotal() {
    const total = getTotal(quantityInputs);
    totalGold.textContent = total.toLocaleString("en-US");

    if (total > availableGold) {
      purchaseMessage.textContent = "You don't have enough gold!";
      purchaseButton.disabled = true;
    } else {
      purchaseMessage.textContent = "";
      purchaseButton.disabled = false;
    }
  }

  quantityInputs.forEach((input) => {
    input.addEventListener("input", updatePurchaseTotal);
  });

  const sellInputs = Array.from(document.querySelectorAll("#sell-form input[data-price]"));
  const sellTotal = document.querySelector("#sell-total");
  const sellButton = document.querySelector("#sell-button");

  if (sellTotal && sellButton) {
    const updateSellTotal = () => {
      const total = getTotal(sellInputs);
      sellTotal.textContent = total.toLocaleString("en-US");
      sellButton.disabled = total <= 0 || sellInputs.some(input => !input.validity.valid);
    };

    sellInputs.forEach(input => input.addEventListener("input", updateSellTotal));
    updateSellTotal();
  }
</script>
