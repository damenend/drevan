<section>
  <h1><%= title %></h1>
  <%- include("../partials/location-image", {
    src: "/images/curious-emporium.webp",
    width: 1672,
    height: 941,
    alt: "Supply stalls and glowing crystals beneath a bronze dome.",
    caption: "The stalls at Curious Emporium.",
  }) %>

  <p>Curious Emporium buys spare gear, fish, and materials and sells provisions for the road. Ask where a relic came from and the proprietor may suddenly remember an errand.</p>
  <%- include("../partials/player-gold", { gold: user.gold }) %>
  <h2 id="buy-heading" tabindex="-1">Buy items</h2>
  <% if (purchased) { %>
  <p tabindex="-1" data-result-focus>Purchase complete.</p>
  <% } %>
  <% if (purchaseError) { %>
  <p class="text-error" tabindex="-1" data-result-focus><%= purchaseError %></p>
  <% } %>
  <%- include("../partials/item-category-nav", {
    label: "Purchase categories", path: "/game/store", headingId: "buy-heading", categories: purchaseCategories,
  }) %>
  <% if (purchaseItems.length === 0) { %>
  <p>No items for purchase in this category.</p>
  <% } else { %>
  <form id="purchase-form" action="/game/store<%= category === "all" ? "" : "?category=" + category %>" method="POST" data-cart-max-total="<%= purchaseGoldLimit %>" data-cart-limit-message="<%= purchaseGoldLimitMessage %>">
    <%- include("../partials/item-table", {
      rows: purchaseItems, rowView: "./purchase-item-row", scrollLabel: "Items for purchase",
      headingId: "buy-heading", columns: ["Item", "Description", "Effect", "Value", "Price", "Quantity"],
    }) %>
    <p id="purchase-message" class="text-error" role="status" data-cart-message></p>
    <button type="submit" class="button--spaced">Purchase<span data-cart-summary hidden> for <span id="total-gold" data-cart-total>0</span> gold</span></button>
  </form>
  <% } %>
  <section id="sell" aria-labelledby="sell-heading">
    <h2 id="sell-heading">Sell items</h2>
    <% if (sold || emptySale) { %>
    <p id="sale-result" tabindex="-1" data-result-focus><%= sold ? "Sale complete." : "You have nothing available to sell here." %></p>
    <% } else if (sellableItems.length === 0) { %>
    <p>You have nothing available to sell here.</p>
    <% } %>
    <% if (sellableItems.length > 0) { %>
    <form id="sell-form" action="/game/store/sell" method="POST"<% if (hasSellableCopies) { %> data-cart-max-total="<%= saleGoldLimit %>" data-cart-limit-message="<%= saleGoldLimitMessage %>"<% } %>>
      <%- include("../partials/item-table", {
        rows: sellableItems, rowView: "./sell-item-row", scrollLabel: "Items for sale",
        headingId: "sell-heading", columns: ["Item", "Available", "Value", "Sell quantity"],
      }) %>
      <% if (hasSellableCopies) { %>
      <p data-cart-summary hidden>
        <label for="sell-total">Sale total</label>:
        <output id="sell-total" aria-live="off" data-cart-total>0</output> gold
      </p>
      <p id="sell-message" class="text-error" role="status" data-cart-message></p>
      <button type="submit" class="button--spaced">Sell</button>
      <% } %>
    </form>
    <% if (hasSellableCopies) { %>
    <form action="/game/store/sell-all" method="POST">
      <p id="sell-all-note">Sell all eligible items in your inventory. Equipped items will be retained.</p>
      <button type="submit" class="button--secondary" aria-describedby="sell-all-note<% if (sellAllExceedsGoldLimit) { %> sell-all-limit<% } %>"<% if (sellAllExceedsGoldLimit) { %> disabled<% } %>>Sell all<% if (Number.isSafeInteger(sellAllTotal)) { %> for <%= formatNumber(sellAllTotal) %> gold<% } %></button>
      <% if (sellAllExceedsGoldLimit) { %>
      <span id="sell-all-limit"><%= saleGoldLimitMessage %></span>
      <% } %>
    </form>
    <% } %>
    <% } %>
  </section>
</section>

<script src="/js/store.js" defer></script>
