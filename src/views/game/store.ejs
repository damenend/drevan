<section>
  <h2><%= title %></h2>
  <%- include("../partials/location-image", {
    src: "/images/curious-emporium.webp",
    alt: "Supply stalls and glowing crystals beneath a bronze dome.",
    caption: "The stalls at Curious Emporium.",
  }) %>

  <p>Curious Emporium buys spare gear and fish and sells provisions for the road. Ask where a relic came from and the proprietor may suddenly remember an errand.</p>
  <%- include("../partials/player-gold", { gold: user.gold }) %>
  <h3>Buy items</h3>
  <form id="purchase-form" action="/game/store" method="POST">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Description</th>
            <th scope="col">Effect</th>
            <th scope="col">Value</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
          <tr>
            <th scope="row">
              <%- include("../partials/item-figure", { item }) %>
            </th>
            <td><%= item.description %></td>
            <td><%= ({ attack_power: "Attack Power", defense: "Defense", heal: "Restore HP" })[item.effect] ?? item.effect ?? "—" %></td>
            <td><%= item.effectValue === null ? "—" : formatNumber(item.effectValue) %></td>
            <td><%= formatNumber(item.price) %> gold</td>
            <td>
              <label for="item-<%= item.id %>" class="visually-hidden">
                Quantity of <%= item.name %>
              </label>
              <input type="number" id="item-<%= item.id %>" name="items[item-<%= item.id %>]" value="0" min="0" step="1" data-price="<%= item.price %>" class="item-quantity">
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p>
      Total:
      <output id="total-gold">0</output> gold
    </p>
    <p id="purchase-message" class="text-error" aria-live="polite">
      <%= err || "" %>
    </p>
    <button type="submit" class="button--spaced">Purchase</button>
  </form>
  <section id="sell" aria-labelledby="sell-heading">
    <h3 id="sell-heading">Sell items</h3>
    <% if (sold) { %>
    <p role="status">Sale complete.</p>
    <% } %>
    <% if (sellableItems.length === 0) { %>
    <p>You have nothing available to sell here.</p>
    <% } else { %>
    <form id="sell-form" action="/game/store/sell" method="POST">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Available</th>
              <th scope="col">Value</th>
              <th scope="col">Sell quantity</th>
            </tr>
          </thead>
          <tbody>
            <% sellableItems.forEach(item => { %>
            <tr>
              <th scope="row">
                <%- include("../partials/item-figure", { item }) %>
              </th>
              <td><%= formatNumber(item.available) %></td>
              <td><%= formatNumber(item.sellPrice) %></td>
              <td>
                <% if (item.available === 0) { %>
                <a href="/game#equipped">Unequip in The Quarters</a>
                <% } else { %>
                <label for="sell-<%= item.id %>" class="visually-hidden">Quantity of <%= item.name %> to sell</label>
                <input type="number" id="sell-<%= item.id %>" name="items[item-<%= item.id %>]" value="0" min="0" max="<%= item.available %>" step="1" data-price="<%= item.sellPrice %>" class="item-quantity">
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (sellableItems.some(item => item.available > 0)) { %>
      <p>
        Sell for
        <output id="sell-total">0</output> gold
      </p>
      <p id="sell-message" class="text-error" aria-live="polite"></p>
      <button type="submit" class="button--spaced">Sell</button>
      <% } %>
    </form>
    <% } %>
  </section>
</section>

<script src="/js/store.js" defer></script>
