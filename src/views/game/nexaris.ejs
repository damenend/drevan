<section aria-labelledby="nexaris-heading">
  <h2 id="nexaris-heading">Nexaris</h2>

  <%- include("../partials/location-image", {
    src: "/images/nexaris-v2.webp",
    alt: "",
    caption: "Nexaris, a refuge among the remnants of the old world.",
  }) %>

  <p>Nexaris grew around the remains of the old world. Machinery of uncertain purpose stands beside homes and market stalls, and there is room here for anyone trying to make a living.</p>

  <% if (message) { %>
  <p role="status"><%= message %></p>
  <% } %>
  <% if (battle) { %>
  <h3>Expedition ended</h3>
  <%- include("../partials/battle-log", { ...battle, compactBattleReport: true }) %>
  <% if (battle.playerHp === 0) { %>
  <p><a href="/game/hospital">Heal at Sanctum</a> before starting another expedition.</p>
  <% } %>
  <% } %>

  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Destination</th>
          <th scope="col">At this location</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><a href="/game">The Quarters</a></th>
          <td>Manage your gear and spend attribute points.</td>
        </tr>
        <tr>
          <th scope="row"><a href="/game/arena">Dominion</a></th>
          <td>Train against practice dummies in the arena.</td>
        </tr>
        <tr>
          <th scope="row"><a href="/game/store">Curious Emporium</a></th>
          <td>Buy supplies and sell spare gear or fish.</td>
        </tr>
        <tr>
          <th scope="row"><a href="/game/hospital">Sanctum</a></th>
          <td>Pay gold to restore HP.</td>
        </tr>
        <tr>
          <th scope="row"><a href="/game/users">The Registry</a></th>
          <td>Find players and view their profiles.</td>
        </tr>
        <tr>
          <th scope="row"><a href="/game/reliquary">The Reliquary</a></th>
          <td>Read surviving accounts of the old world.</td>
        </tr>
        <tr>
          <th scope="row"><a href="/game/fishing">The Driftwater</a></th>
          <td>Cast a line in the glowing waters beyond Nexaris.</td>
        </tr>
        <tr>
          <th scope="row"><a href="/game/ruins">The Ruins</a></th>
          <td>Search buried chambers for supplies and gold.</td>
        </tr>
      </tbody>
    </table>
  </div>

</section>
