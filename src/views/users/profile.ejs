<section>
  <h1><%= formatPlayerName(player.name) %></h1>
  <%- include("../partials/player-avatar", { player }) %>

  <dl class="character-stats">
    <div class="character-stat">
      <dt>Game ID</dt>
      <dd><%= player.id %></dd>
    </div>
    <div class="character-stat">
      <dt>Level</dt>
      <dd><%= formatNumber(playerLevel) %></dd>
    </div>
    <div class="character-stat">
      <dt>Class</dt>
      <dd><%= formatCharacterClass(player.characterClass) %></dd>
    </div>
    <% if (classPassive) { %>
    <div class="character-stat">
      <dt>Class passive</dt>
      <dd>
        <%= classPassive.name %>
        <span class="character-stat-breakdown"><%= classPassive.description %></span>
      </dd>
    </div>
    <% } %>
  </dl>
  <p><a href="/game/users">Return to The Registry</a></p>
</section>
