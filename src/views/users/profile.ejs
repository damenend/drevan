<section class="page">
  <h2><%= formatPlayerName(player.name) %></h2>
  <%- include("../partials/player-avatar", { player }) %>

  <dl class="character-stats">
    <div class="character-stat">
      <dt>Game ID</dt>
      <dd><%= player.id %></dd>
    </div>
    <div class="character-stat">
      <dt>Level</dt>
      <dd><%= formatNumber(playerLevel) %></dd>
    </div>
  </dl>
  <p><a href="/game/users">Back to The Registry</a></p>
</section>
