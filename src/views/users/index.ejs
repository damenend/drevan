<section class="page">
  <h2>The Registry</h2>

  <%- include("../partials/location-image", {
    src: "/images/the-registry.webp",
    caption: "The Registry, Drevan's directory of players.",
  }) %>

  <% if (players.length === 0) { %>
  <p>No players are listed yet.</p>
  <% } else { %>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Level</th>
        </tr>
      </thead>
      <tbody>
        <% players.forEach(player => { %>
        <tr>
          <th scope="row"><a href="/game/users/<%= player.id %>"><%= formatPlayerName(player.name) %></a></th>
          <td><%= formatNumber(player.level) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
