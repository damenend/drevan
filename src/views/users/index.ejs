<section class="page">
  <h3>Registered players</h3>
  <% if (players.length === 0) { %>
  <p>No registered users yet.</p>
  <% } else { %>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Level</th>
        </tr>
      </thead>
      <tbody>
        <% players.forEach(player => { %>
        <tr>
          <th scope="row"><a href="/users/<%= player.id %>"><%= formatPlayerName(player.name) %></a></th>
          <td><%= formatNumber(playerLevel) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>
