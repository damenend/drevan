<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Drevan is a text-driven science-fantasy RPG. Train, trade, and explore the remnants of the old world." />
  <title><%= title && `${title} | ` %>Drevan</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css" />
  <script src="/js/page-accessibility.js" defer></script>
</head>

<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <%- include("../partials/header") %>
  <main id="main-content" tabindex="-1">
    <div class="container"><%- body %></div>
  </main>
  <%- include("../partials/footer") %>
</body>

</html>
