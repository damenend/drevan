<section aria-labelledby="error-heading">
  <h1 id="error-heading"><%= status %> · <%= title %></h1>
  <p><%= message %></p>
  <% if (recoveryLink) { %>
  <p><a href="<%= recoveryLink.href %>"><%= recoveryLink.label %></a></p>
  <% } else { %>
  <p><a href="<%= user ? '/game' : '/' %>"><%= user ? "Return to The Quarters" : "Return to the homepage" %></a></p>
  <% } %>
</section>
